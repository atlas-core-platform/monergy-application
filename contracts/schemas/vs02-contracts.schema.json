{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.monergy.invalid/vs02/1.0.0",
  "title": "VS-02 Evidence to Financial Truth contracts",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractId",
    "contractName",
    "contractVersion",
    "requestId",
    "correlationId",
    "security",
    "payload"
  ],
  "properties": {
    "contractId": {
      "enum": [
        "CID-020",
        "CID-021",
        "CID-022",
        "CID-023",
        "CID-024",
        "CID-025",
        "CID-027",
        "CID-028",
        "CID-031",
        "CID-033",
        "CID-034",
        "CID-035",
        "CID-055",
        "CID-057"
      ]
    },
    "contractName": {
      "enum": [
        "CreateDocumentVersion",
        "GetEvidenceMetadata",
        "GetEvidenceReference",
        "EvidenceRegistered",
        "EvidenceVersionCreated",
        "ProcessDocument",
        "GetProcessingStatus",
        "ValidatedSourceFactsProduced",
        "NormalizeSourceFacts",
        "GetFinancialProvenance",
        "FinancialFactCreated",
        "FinancialFactUpdated",
        "ScheduleJob",
        "GetJobStatus"
      ]
    },
    "contractVersion": { "const": "1.0.0" },
    "requestId": { "type": "string", "minLength": 1 },
    "correlationId": { "type": "string", "minLength": 1 },
    "causationId": { "type": ["string", "null"] },
    "security": {
      "type": "object",
      "required": ["actor", "workload", "access"],
      "properties": {
        "actor": { "type": "object" },
        "workload": { "type": "object" },
        "access": { "type": "object" }
      }
    },
    "payload": { "type": "object" }
  }
}
