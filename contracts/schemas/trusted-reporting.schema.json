{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.monergy.local/trusted-reporting.schema.json",
  "title": "MWP-03-D08 trusted reporting contract envelope",
  "oneOf": [
    { "$ref": "#/$defs/generateReport" },
    { "$ref": "#/$defs/getReport" },
    { "$ref": "#/$defs/reportGenerated" }
  ],
  "$defs": {
    "security": {
      "type": "object",
      "required": ["actor", "workload", "access"],
      "properties": {
        "actor": { "type": "object" },
        "workload": { "type": "object" },
        "access": { "type": "object" }
      },
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "required": [
        "contractName",
        "contractVersion",
        "requestId",
        "correlationId",
        "security",
        "payload"
      ],
      "properties": {
        "contractName": { "type": "string" },
        "contractVersion": { "const": "1.0.0" },
        "requestId": { "type": "string", "minLength": 1 },
        "correlationId": { "type": "string", "minLength": 1 },
        "causationId": { "type": ["string", "null"] },
        "security": { "$ref": "#/$defs/security" },
        "idempotencyKey": { "type": ["string", "null"] },
        "payload": { "type": "object" }
      },
      "additionalProperties": false
    },
    "generateReport": {
      "allOf": [
        { "$ref": "#/$defs/request" },
        { "properties": { "contractName": { "const": "GenerateReport" } } }
      ]
    },
    "getReport": {
      "allOf": [
        { "$ref": "#/$defs/request" },
        { "properties": { "contractName": { "const": "GetReport" } } }
      ]
    },
    "reportGenerated": {
      "type": "object",
      "required": ["contractId", "eventName", "eventVersion", "payload"],
      "properties": {
        "contractId": { "const": "CID-053" },
        "eventName": { "const": "ReportGenerated" },
        "eventVersion": { "const": "1.0.0" },
        "payload": { "type": "object" }
      }
    }
  },
  "unevaluatedProperties": false
}
