  "$defs": {
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "workload", "access"],
      "properties": {
        "actor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["actorId", "actorType", "authenticatedAt", "authenticationContextId"],
          "properties": {
            "actorId": {
              "type": "string",
              "minLength": 1
            },
            "actorType": {
              "type": "string",
              "minLength": 1
            },
            "authenticatedAt": {
              "type": "string",
              "format": "date-time"
            },
            "authenticationContextId": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "workload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["workloadId", "workloadIdentityId"],
          "properties": {
            "workloadId": {
              "type": "string",
              "minLength": 1
            },
            "workloadIdentityId": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "access": {
          "type": "object",
          "additionalProperties": false,
          "required": ["purpose", "consentReferenceId", "authorizationContextId", "customerId"],
          "properties": {
            "purpose": {
              "type": "string",
              "minLength": 1
            },
            "consentReferenceId": {
              "type": ["string", "null"]
            },
            "authorizationContextId": {
              "type": "string",
              "minLength": 1
            },
            "customerId": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "financialFactId", "expectedRevision"],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "financialFactId": {
          "type": "string",
          "minLength": 1
        },
        "expectedRevision": {
          "type": ["integer", "null"],
          "minimum": 1
        }
      }
    }
  }
