{
  "color": {
    "brand": {
      "primary": "#2457a7",
      "primaryHover": "#1d478a",
      "onPrimary": "#ffffff"
    },
    "neutral": {
      "0": "#ffffff",
      "50": "#f6f8fb",
      "100": "#edf1f6",
      "300": "#cbd4df",
      "600": "#526173",
      "800": "#263241",
      "950": "#111820"
    },
    "state": {
      "success": "#1b7f4b",
      "warning": "#9a5b08",
      "error": "#b42318",
      "info": "#2457a7"
    }
  },
  "typography": {
    "fontFamily": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif",
    "fontFamilyMono": "Cascadia Code, SFMono-Regular, Consolas, monospace",
    "baseSize": "15px",
    "lineHeight": 1.6,
    "smallSize": "13px",
    "labelSize": "14px",
