{
  "schemaVersion": "1.0.0",
  "deliverable": "MWP-03-D03",
  "slice": {
    "id": "VS-02",
    "title": "Evidence to Financial Truth",
    "status": "IMPLEMENTATION_CANDIDATE"
  },
  "features": [
    {
      "id": "M2-WS03-E01-F02",
      "name": "Evidence metadata & versioning",
      "owner": "Evidence Service",
      "participatingServices": ["Evidence Service"],
      "acceptanceBoundary": "Document identity, version and source metadata remain stable and traceable."
    },
    {
      "id": "M2-WS03-E02-F01",
      "name": "Document-processing pipeline",
      "owner": "Document Intelligence Service",
      "participatingServices": [
        "Evidence Service",
        "Document Intelligence Service",
        "Job Management Service"
      ],
      "acceptanceBoundary": "Authorized evidence can be scheduled, processed and tracked independently of user requests."
    },
    {
      "id": "M2-WS03-E02-F02",
      "name": "Structured extraction & confidence",
      "owner": "Document Intelligence Service",
      "participatingServices": ["Document Intelligence Service"],
      "acceptanceBoundary": "Extracted candidate facts retain source location and confidence and are not authoritative truth."
    },
    {
      "id": "M2-WS03-E03-F01",
      "name": "Canonical source-fact contract",
      "owner": "Document Intelligence Service",
      "participatingServices": ["Document Intelligence Service", "Financial Profile Service"],
      "acceptanceBoundary": "Document output is expressed without external or extraction-provider schema leakage."
    },
    {
      "id": "M2-WS03-E03-F02",
      "name": "Evidence/provenance reference handoff",
      "owner": "Document Intelligence Service",
      "participatingServices": [
        "Evidence Service",
        "Document Intelligence Service",
        "Financial Profile Service"
      ],
      "acceptanceBoundary": "Every candidate normalized fact retains a stable authorized source-evidence reference."
    },
    {
      "id": "M2-WS03-E03-F03",
      "name": "Financial Profile normalization handoff",
      "owner": "Financial Profile Service",
      "participatingServices": ["Document Intelligence Service", "Financial Profile Service"],
      "acceptanceBoundary": "Validated facts enter Financial Profile through its contract rather than a direct persistence write."
    },
    {
      "id": "M2-WS04-E03-F01",
      "name": "Provider-neutral normalization",
      "owner": "Financial Profile Service",
      "participatingServices": ["Financial Profile Service"],
      "acceptanceBoundary": "Canonical financial information is created without provider-specific schema leakage."
    },
    {
      "id": "M2-WS04-E03-F02",
      "name": "Financial provenance",
      "owner": "Financial Profile Service",
      "participatingServices": [
        "Evidence Service",
        "Document Intelligence Service",
        "Financial Profile Service"
      ],
      "acceptanceBoundary": "Important authoritative facts retain immutable evidence and source provenance."
    }
  ],
  "contracts": [
    {
      "id": "CID-020",
      "name": "CreateDocumentVersion",
      "type": "COMMAND",
      "owner": "Evidence Service",
      "producer": "Evidence Service",
      "consumers": ["Document Intelligence Service"],
      "direction": "Document Intelligence Service -> Evidence Service"
    },
    {
      "id": "CID-021",
      "name": "GetEvidenceMetadata",
      "type": "QUERY",
      "owner": "Evidence Service",
      "producer": "Evidence Service",
      "consumers": [
        "Document Intelligence Service",
        "Search & Retrieval Service",
        "Reporting Service"
      ],
      "direction": "Authorized consumer -> Evidence Service"
    },
    {
      "id": "CID-022",
      "name": "GetEvidenceReference",
      "type": "QUERY",
      "owner": "Evidence Service",
      "producer": "Evidence Service",
      "consumers": [
        "Document Intelligence Service",
        "Financial Profile Service",
        "Reporting Service"
      ],
      "direction": "Authorized consumer -> Evidence Service"
    },
    {
      "id": "CID-023",
      "name": "EvidenceRegistered",
      "type": "EVENT",
      "owner": "Evidence Service",
      "producer": "Evidence Service",
      "consumers": ["Document Intelligence Service", "Audit Service"],
      "direction": "Evidence Service -> consumers"
    },
    {
      "id": "CID-024",
      "name": "EvidenceVersionCreated",
      "type": "EVENT",
      "owner": "Evidence Service",
      "producer": "Evidence Service",
      "consumers": ["Document Intelligence Service", "Search & Retrieval Service", "Audit Service"],
      "direction": "Evidence Service -> consumers"
    },
    {
      "id": "CID-025",
      "name": "ProcessDocument",
      "type": "JOB",
      "owner": "Document Intelligence Service",
      "producer": "Document Intelligence Service",
      "consumers": ["Evidence Service", "Job Management Service"],
      "direction": "Evidence Service or Job Management Service -> Document Intelligence Service"
    },
    {
      "id": "CID-027",
      "name": "GetProcessingStatus",
      "type": "QUERY",
      "owner": "Document Intelligence Service",
      "producer": "Document Intelligence Service",
      "consumers": ["Evidence Service", "Job Management Service"],
      "direction": "Authorized consumer -> Document Intelligence Service"
    },
    {
      "id": "CID-028",
      "name": "ValidatedSourceFactsProduced",
      "type": "EVENT",
      "owner": "Document Intelligence Service",
      "producer": "Document Intelligence Service",
      "consumers": ["Financial Profile Service", "Audit Service"],
      "direction": "Document Intelligence Service -> consumers"
    },
    {
      "id": "CID-031",
      "name": "NormalizeSourceFacts",
      "type": "COMMAND",
      "owner": "Financial Profile Service",
      "producer": "Financial Profile Service",
      "consumers": ["Document Intelligence Service", "Integration Gateway Service"],
      "direction": "Document Intelligence Service -> Financial Profile Service"
    },
    {
      "id": "CID-033",
      "name": "GetFinancialProvenance",
      "type": "QUERY",
      "owner": "Financial Profile Service",
      "producer": "Financial Profile Service",
      "consumers": ["Financial Rules Service", "Search & Retrieval Service", "Reporting Service"],
      "direction": "Authorized consumer -> Financial Profile Service"
    },
    {
      "id": "CID-034",
      "name": "FinancialFactCreated",
      "type": "EVENT",
      "owner": "Financial Profile Service",
      "producer": "Financial Profile Service",
      "consumers": ["Financial Rules Service", "Search & Retrieval Service", "Audit Service"],
      "direction": "Financial Profile Service -> consumers"
    },
    {
      "id": "CID-035",
      "name": "FinancialFactUpdated",
      "type": "EVENT",
      "owner": "Financial Profile Service",
      "producer": "Financial Profile Service",
      "consumers": ["Financial Rules Service", "Search & Retrieval Service", "Audit Service"],
      "direction": "Financial Profile Service -> consumers"
    },
    {
      "id": "CID-055",
      "name": "ScheduleJob",
      "type": "JOB",
      "owner": "Job Management Service",
      "producer": "Job Management Service",
      "consumers": [
        "Document Intelligence Service",
        "Search & Retrieval Service",
        "Reporting Service",
        "Integration Gateway Service"
      ],
      "direction": "Workload requester -> Job Management Service"
    },
    {
      "id": "CID-057",
      "name": "GetJobStatus",
      "type": "QUERY",
      "owner": "Job Management Service",
      "producer": "Job Management Service",
      "consumers": [
        "Document Intelligence Service",
        "Search & Retrieval Service",
        "Reporting Service",
        "Integration Gateway Service"
      ],
      "direction": "Authorized consumer -> Job Management Service"
    }
  ],
  "participatingServices": [
    "Evidence Service",
    "Document Intelligence Service",
    "Financial Profile Service",
    "Job Management Service",
    "Audit Service"
  ],
  "businessObjects": [
